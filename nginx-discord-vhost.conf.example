# YOUR_DOMAIN — the browser surface of discord-signup-store.
#
# WHAT IS DELIBERATELY NOT HERE: any location for /api/. Those routes edit
# rosters and carry no auth of their own; they are reachable only on
# 127.0.0.1:8312. Adding an /api/ location to this file publishes roster
# editing to the internet. The browser routes proxied below all require a
# Discord login and check guild membership inside the service.
#
# /interactions is also absent: it lives on the dash vhost, where it was
# registered with Discord, and one endpoint URL is all an application gets.

server {
    server_name YOUR_DOMAIN;

    # Avatar photos (15 MB) and the images on an organizer's message (8 MB)
    # come up through here; nginx's own default of 1 MB would refuse them
    # with a 413 before the service could say why.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8312;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The service sets Secure cookies. Without this it cannot tell it is
        # behind TLS, and a browser would silently drop every session cookie.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # The machine API, refused at the edge as well as by not being proxied.
    # Belt and braces: if someone later adds a broad location above, this still
    # stands between the internet and an unauthenticated roster editor.
    location /api/ { deny all; }

    listen 80;
}
